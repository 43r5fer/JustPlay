{
  "name": "justplay-launcher",
  "version": "0.2.0",
  "description": "JustPlay — a clean Windows launcher for Minecraft Java Edition",
  "main": "electron/main.cjs",
  "author": "JustPlay contributors",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check src/renderer.js && node --check scripts/write-update-manifest.cjs"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.justplay.launcher",
    "productName": "JustPlay",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "JustPlay.${ext}",
      "icon": "assets/justplay.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JustPlay"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "43r5fer",
        "repo": "JustPlay",
        "releaseType": "release"
      }
    ]
  }
}
