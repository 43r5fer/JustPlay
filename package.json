{
  "name": "flock-messenger",
  "version": "1.0.0",
  "description": "Flock — cross-platform messaging for your people",
  "main": "electron/main.cjs",
  "author": "Flock contributors",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check src/renderer.js && node --check scripts/write-update-manifest.cjs && node --check scripts/build-mobile.mjs && node --check scripts/patch-android-manifest.mjs",
    "mobile:prepare": "node scripts/build-mobile.mjs",
    "mobile:android": "npm run mobile:prepare && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3"
  },
  "build": {
    "appId": "com.flock.messaging",
    "productName": "Flock",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "JustPlay.${ext}",
      "icon": "assets/justplay.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flock"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "43r5fer",
        "repo": "JustPlay",
        "releaseType": "release"
      }
    ],
    "artifactName": "Flock-Setup.${ext}"
  }
}
